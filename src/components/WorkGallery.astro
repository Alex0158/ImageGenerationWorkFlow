---
import WorkPicture from '@/components/WorkPicture.astro';
import { ctaLabels } from '@/data/site';
import { featuredWorks } from '@/data/works';

const galleryWorks = featuredWorks.slice(0, 9);
---

<section class="section" id="work" aria-labelledby="work-title">
  <div class="work-header" data-reveal>
    <div>
      <div class="section-kicker">Selected Work</div>
      <h2 class="section-heading" id="work-title">Work that sells the mood before the customer reads the offer.</h2>
    </div>
    <div class="work-header-copy">
      <p class="section-intro">
        This is not a random gallery. Each piece is designed for a real commercial moment: openings, menus, social campaigns, hospitality offers, events, and brand upgrades.
      </p>
      <a class="text-button" href="#contact">Discuss a similar project</a>
    </div>
  </div>

  <div class="work-grid" data-stagger>
    {galleryWorks.map((work) => (
      <article class="work-card" data-reveal>
        <div class="work-image">
          <WorkPicture work={work} sizes="(max-width: 680px) 92vw, (max-width: 1060px) 44vw, 30vw" />
        </div>
        <div class="work-meta">
          <div class="work-id">{work.id}</div>
          <div>
            <div class="work-title">{work.title}</div>
            <div class="work-discipline">{work.category} / {work.discipline}</div>
            <p class="work-outcome">{work.outcome}</p>
          </div>
        </div>
      </article>
    ))}
  </div>

  <div class="work-cta-panel" data-reveal>
    <span>Seen enough to shape the direction?</span>
    <p>Send a rough brief and I will turn it into the right scope before design production starts.</p>
    <a class="button is-dark" href="#contact">{ctaLabels.primary}</a>
  </div>
</section>
