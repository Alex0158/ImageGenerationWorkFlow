---
import WorkPicture from '@/components/WorkPicture.astro';
import { heroWorks } from '@/data/works';
import { ctaLabels, heroAssurances } from '@/data/site';

const heroMainWork = heroWorks[3] ?? heroWorks[0];
const heroSupportWorks = heroWorks.filter((work) => work.slug !== heroMainWork.slug).slice(0, 3);
const heroClasses = ['is-side', 'is-small', 'is-strip'];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy" data-reveal>
    <div class="hero-label">Independent graphic designer / Campaign systems / Hospitality visuals</div>
    <h1 id="hero-title">Launch-ready visual systems for hospitality and lifestyle brands.</h1>
    <p class="hero-catalog">Campaign Kits / Menus / Posters / Identity Refreshes / Social Rollouts</p>
    <ul class="hero-preview-row" aria-label="Fast preview of selected work">
      {heroWorks.map((work, i) => (
        <li>
          <WorkPicture
            work={work}
            sizes="110px"
            alt={work.title}
            loading="eager"
            fetchpriority={i === 0 ? 'high' : 'auto'}
          />
        </li>
      ))}
      <li>Selected commercial systems</li>
    </ul>
    <p class="hero-subcopy">
      I shape the key visual, menu hierarchy, poster system, and social assets so your launch looks considered before anyone asks the price.
    </p>
    <div class="hero-actions">
      <a class="button is-dark" href="#contact" data-brief-intent="Campaign Kit" data-brief-project-type="Campaign Visual" data-brief-budget="HKD 15,000 - 35,000" data-brief-source="Hero primary CTA">{ctaLabels.primary}</a>
      <a class="text-button" href="#showcase">{ctaLabels.secondary}</a>
      <p class="hero-note">For founders and brands that need a stronger visual system before launch, promotion, or repositioning.</p>
    </div>
    <ul class="hero-assurance-row" aria-label="Project assurance">
      {heroAssurances.map((item) => <li>{item}</li>)}
    </ul>
  </div>

  <div class="hero-collage" aria-label="Selected design work collage" data-reveal data-proof-drop>
    <figure class="collage-card is-main">
      <WorkPicture work={heroMainWork} sizes="(max-width: 680px) 76vw, 42vw" loading="eager" fetchpriority="high" />
    </figure>
    {heroSupportWorks.map((work, index) => (
      <figure class={`collage-card ${heroClasses[index]}`}>
        <WorkPicture work={work} sizes="(max-width: 680px) 42vw, 18vw" loading="eager" fetchpriority="auto" />
      </figure>
    ))}
    <div class="collage-caption">
      Main artifact: chef-led launch campaign. Supporting slips show menu hierarchy, opening posters, and social-ready crops.
    </div>
    <div class="hero-proof-card">
      <span>Opening-ready</span>
      <strong>One visual direction, prepared for posters, menus, and social rollout.</strong>
    </div>
  </div>
</section>
