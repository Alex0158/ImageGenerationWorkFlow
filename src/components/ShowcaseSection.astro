---
import WorkPicture from '@/components/WorkPicture.astro';
import { ctaLabels } from '@/data/site';
import { featuredWorks } from '@/data/works';

const showcaseWorks = featuredWorks.slice(0, 5);
const getShowcaseIds = (slug: string, index: number) => ({
  cardId: `showcase-card-${slug}-${index}`,
  metaId: `showcase-meta-${slug}-${index}`,
  dotId: `showcase-dot-${slug}-${index}`,
});

const getInitialShowcaseSlot = (index: number) => {
  if (index === 0) return 'active';
  if (index === 1) return 'next';
  if (index === 2) return 'far-next';
  if (index === showcaseWorks.length - 1) return 'prev';
  if (index === showcaseWorks.length - 2) return 'far-prev';
  return 'hidden';
};
---

<section class="showcase-section" id="showcase" aria-labelledby="showcase-title">
  <div class="showcase-copy" data-reveal>
    <div class="section-kicker">Signature Showcase</div>
    <h2 class="showcase-title" id="showcase-title">A curated wall of launch-ready graphics.</h2>
    <p class="section-intro">
      Selected posters, menus, and campaign systems presented as working commercial artifacts, not decorative mood boards.
    </p>
  </div>

  <div class="showcase-shell" data-carousel role="region" aria-label="Signature showcase carousel">
    <div class="showcase-controls" aria-label="Showcase controls">
      <button class="showcase-control" type="button" data-carousel-prev aria-label="Previous work">Prev</button>
      <div class="showcase-counter" aria-live="polite"><span data-carousel-current>01</span> / {showcaseWorks.length.toString().padStart(2, '0')}</div>
      <button class="showcase-control" type="button" data-carousel-next aria-label="Next work">Next</button>
    </div>

    <div class="showcase-stage" aria-label="Featured work carousel">
      <div class="showcase-orbit" aria-hidden="true"></div>
      {showcaseWorks.map((work, index) => (
        <article
          class="showcase-card"
          data-carousel-card
          data-index={index}
          data-slot={getInitialShowcaseSlot(index)}
          id={getShowcaseIds(work.slug, index).cardId}
          aria-label={`Showcase card ${index + 1}: ${work.title}`}
          aria-hidden={getInitialShowcaseSlot(index) === 'hidden' ? 'true' : 'false'}
        >
          <div class="showcase-card-inner">
            <WorkPicture work={work} sizes="(max-width: 680px) 78vw, 28vw" />
            <div class="showcase-card-label">
              <span>{work.id}</span>
              <strong>{work.title}</strong>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="showcase-bottom">
      <div class="showcase-active-meta" aria-live="polite">
        {showcaseWorks.map((work, index) => (
          <div
            class:list={['showcase-meta-item', { 'is-active': index === 0 }]}
            data-carousel-meta
            data-index={index}
            id={getShowcaseIds(work.slug, index).metaId}
          >
            <span>{work.moment ?? work.category}</span>
            <strong>{work.title}</strong>
            <p>{work.outcome}</p>
            <dl class="showcase-proof-list">
              <div><dt>Problem</dt><dd>{work.problem ?? 'The brand needed a clearer commercial first impression.'}</dd></div>
              <div><dt>Visual move</dt><dd>{work.visualMove ?? 'A focused hierarchy, stronger art direction, and usable rollout system.'}</dd></div>
              <div><dt>Output</dt><dd>{work.output ?? 'Campaign visual prepared for print, social, and launch use.'}</dd></div>
            </dl>
          </div>
        ))}
      </div>
      <div class="showcase-actions" aria-label="Showcase next steps">
        <a class="button is-light" href="#contact" data-brief-intent="Campaign Kit" data-brief-project-type="Campaign Visual" data-brief-budget="HKD 15,000 - 35,000" data-brief-source="Showcase">{ctaLabels.primary}</a>
        <a class="text-button" href="#work">See selected work</a>
      </div>
      <div class="showcase-dots" id="showcase-tabs" role="tablist" aria-label="Showcase work items">
        {showcaseWorks.map((work, index) => (
          <button
            type="button"
            role="tab"
            data-carousel-dot
            data-index={index}
            data-controls={getShowcaseIds(work.slug, index).cardId}
            data-describedby={getShowcaseIds(work.slug, index).metaId}
            id={getShowcaseIds(work.slug, index).dotId}
            class:list={{ 'is-active': index === 0 }}
            aria-controls={getShowcaseIds(work.slug, index).cardId}
            aria-current={index === 0 ? 'true' : 'false'}
            aria-describedby={getShowcaseIds(work.slug, index).metaId}
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-label={`Show ${work.title}`}
            tabindex={index === 0 ? 0 : -1}
          >
            <span>{(index + 1).toString().padStart(2, '0')}</span>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>
