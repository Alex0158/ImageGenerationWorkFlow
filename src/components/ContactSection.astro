---
import {
  briefPromise,
  budgetOptions,
  contactLinks,
  ctaLabels,
  projectTypeOptions,
  siteMeta,
  timelineOptions,
} from '@/data/site';
---

<section class="contact-section" id="contact" aria-labelledby="contact-title">
  <div class="contact-panel" data-reveal>
    <div>
      <div class="section-kicker">Start Project</div>
      <h2 class="contact-title" id="contact-title">Start with a clear brief, not a perfect brief.</h2>
      <p class="contact-text">
        You do not need a perfect brief. Tell me what you are launching, what feels weak visually, your timeline, and your approximate budget.
      </p>
      <p class="contact-text">
        Best fit for founders, restaurants, lifestyle businesses, creators, and launch teams who need design that feels sharp, direct, and commercially usable.
      </p>
      <div class="brief-promise" aria-label="Brief expectations">
        {briefPromise.map((item) => (
          <div>
            <span>{item.number}</span>
            <strong>{item.title}</strong>
          </div>
        ))}
      </div>
      <div class="contact-links" aria-label="Direct contact links">
        {contactLinks.map((link) => <a class="button" href={link.href}>{link.label}</a>)}
      </div>
    </div>

    <form class="brief-form" action={`mailto:${siteMeta.email}`} method="post" enctype="text/plain" data-brief-form data-brief-email={siteMeta.email}>
      <div class="brief-form-head">
        <span>Project Intake</span>
        <strong>Short, structured, enough to start.</strong>
      </div>
      <div class="form-row">
        <div class="form-field">
          <label for="name">Name</label>
          <input id="name" name="name" autocomplete="name" placeholder="Your name or brand contact" required />
          <div class="helper">So I know who I am speaking with.</div>
        </div>
        <div class="form-field">
          <label for="brand">Brand / Project Name</label>
          <input id="brand" name="brand" placeholder="Example: cafe opening, product launch, personal brand refresh" />
          <div class="helper">If there is no final name yet, describe the project type.</div>
        </div>
      </div>

      <div class="form-row">
        <div class="form-field">
          <label for="contact-method">Email or WhatsApp</label>
          <input id="contact-method" name="contact" autocomplete="email" placeholder="email@example.com / WhatsApp number" required />
          <div class="helper">Leave the easiest way to reply.</div>
        </div>
        <div class="form-field">
          <label for="project-type">Project Type</label>
          <select id="project-type" name="project_type" required>
            <option value="">Select one</option>
            {projectTypeOptions.map((option) => <option>{option}</option>)}
          </select>
          <div class="helper">Choose Not sure yet if you want help shaping the scope.</div>
        </div>
      </div>

      <div class="form-row">
        <div class="form-field">
          <label for="budget">Budget Range</label>
          <select id="budget" name="budget" required>
            <option value="">Select one</option>
            {budgetOptions.map((option) => <option>{option}</option>)}
          </select>
          <div class="helper">Budget range helps define the right depth of design work.</div>
        </div>
        <div class="form-field">
          <label for="timeline">Timeline</label>
          <select id="timeline" name="timeline" required>
            <option value="">Select one</option>
            {timelineOptions.map((option) => <option>{option}</option>)}
          </select>
          <div class="helper">For urgent launches, include the hard deadline in the message.</div>
        </div>
      </div>

      <div class="form-field">
        <label for="message">What are you trying to design or improve?</label>
        <textarea id="message" name="message" placeholder="Example: We are opening a cafe and need branding, menu design, opening posters, and Instagram launch assets."></textarea>
        <div class="helper">Describe the goal, current visual problem, desired style, and any references.</div>
      </div>

      <div class="form-footer">
        <button class="button is-dark" type="submit">{ctaLabels.submitBrief}</button>
        <span class="helper">I reply within 24-48 hours with the clearest next step for your project.</span>
      </div>
      <div class="form-status" aria-live="polite" data-brief-status></div>
    </form>
  </div>
</section>
