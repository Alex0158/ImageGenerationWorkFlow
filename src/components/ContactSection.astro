---
import {
  briefPromise,
  budgetOptions,
  contactLinks,
  ctaLabels,
  projectTypeOptions,
  siteMeta,
  timelineOptions,
} from '@/data/site';

const isExternalLink = (href: string) => /^https?:\/\//i.test(href);
---

<section class="contact-section" id="contact" aria-labelledby="contact-title">
  <div class="contact-panel" data-reveal>
    <div>
      <div class="section-kicker">Start Project</div>
      <h2 class="contact-title" id="contact-title">Start with a clear brief, not a perfect brief.</h2>
      <p class="contact-text">
        You do not need a perfect brief. Tell me what you are launching, what feels weak visually, your timeline, and your approximate budget.
      </p>
      <p class="contact-text">
        Best fit for founders, restaurants, lifestyle businesses, creators, and launch teams who need design that feels sharp, direct, and commercially usable.
      </p>
      <div class="brief-promise" aria-label="Brief expectations">
        {briefPromise.map((item) => (
          <div>
            <span>{item.number}</span>
            <strong>{item.title}</strong>
          </div>
        ))}
      </div>
      <ul class="contact-links" aria-label="Direct contact links">
        {contactLinks.map((link) => (
          <li>
            <a
              class="button"
              href={link.href}
              target={isExternalLink(link.href) ? '_blank' : undefined}
              rel={isExternalLink(link.href) ? 'noopener noreferrer' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <form class="brief-form" action={`mailto:${siteMeta.email}`} method="post" enctype="text/plain" data-brief-form data-brief-email={siteMeta.email}>
      <div class="brief-form-head">
        <span>Project Intake</span>
        <strong>Short, structured, enough to start.</strong>
      </div>
      <div class="selected-brief" data-brief-selected hidden>
        <span>Selected starting point</span>
        <strong data-brief-selected-title>Campaign Kit</strong>
        <p data-brief-selected-meta>HKD 15,000 - 35,000 / 1-3 weeks</p>
      </div>
      <input type="hidden" id="selected-scope" name="selected_scope" value="" data-selected-scope />
      <input type="hidden" id="brief-source" name="brief_source" value="" data-brief-source />
      <div class="form-row">
        <div class="form-field">
          <label for="name">Name</label>
          <input id="name" name="name" autocomplete="name" placeholder="Your name or brand contact" required aria-describedby="name-help" />
          <div id="name-help" class="helper">So I know who I am speaking with.</div>
        </div>
        <div class="form-field">
          <label for="brand">Brand / Project Name</label>
          <input
            id="brand"
            name="brand"
            placeholder="Example: cafe opening, product launch, personal brand refresh"
            aria-describedby="brand-help"
          />
          <div id="brand-help" class="helper">If there is no final name yet, describe the project type.</div>
        </div>
      </div>

      <div class="form-row">
        <div class="form-field">
          <label for="contact-method">Email or WhatsApp</label>
          <input
            id="contact-method"
            name="contact"
            autocomplete="email"
            placeholder="email@example.com / WhatsApp number"
            required
            aria-describedby="contact-help"
          />
          <div id="contact-help" class="helper">Leave the easiest way to reply.</div>
        </div>
        <div class="form-field">
          <label for="project-type">Project Type</label>
          <select id="project-type" name="project_type" required aria-describedby="project-type-help">
            <option value="">Select one</option>
            {projectTypeOptions.map((option) => <option>{option}</option>)}
          </select>
          <div id="project-type-help" class="helper">Choose "Not sure yet" if you need help setting the scope.</div>
        </div>
      </div>

      <div class="form-row">
        <div class="form-field">
          <label for="budget">Budget Range</label>
          <select id="budget" name="budget" required aria-describedby="budget-help">
            <option value="">Select one</option>
            {budgetOptions.map((option) => <option>{option}</option>)}
          </select>
          <div id="budget-help" class="helper">Budget range helps define the right depth of design work.</div>
        </div>
        <div class="form-field">
          <label for="timeline">Timeline</label>
          <select id="timeline" name="timeline" required aria-describedby="timeline-help">
            <option value="">Select one</option>
            {timelineOptions.map((option) => <option>{option}</option>)}
          </select>
          <div id="timeline-help" class="helper">For urgent launches, include the hard deadline in the message.</div>
        </div>
      </div>

      <div class="form-field">
        <label for="message">What are you trying to design or improve?</label>
        <textarea
          id="message"
          name="message"
          placeholder="Example: Goal: opening a cafe. Deadline: early June. References: warm Italian posters, clear menu hierarchy, Instagram launch assets."
          aria-describedby="message-help"
        ></textarea>
        <div id="message-help" class="helper">Add the goal, hard deadline, current visual problem, and any references if you have them.</div>
      </div>

      <div class="form-footer">
        <button class="button is-dark" type="submit">{ctaLabels.submitBrief}</button>
        <span class="helper">Best projects usually start from HKD 5,000; campaign systems usually start from HKD 15,000.</span>
      </div>
      <div class="form-status" role="status" aria-live="polite" aria-atomic="true" data-brief-status></div>
      <div class="brief-fallbacks" aria-label="Brief fallback actions">
        <a class="text-button" href={siteMeta.whatsappUrl} target="_blank" rel="noopener noreferrer" data-brief-whatsapp>Send via WhatsApp</a>
        <button class="text-button" type="button" data-brief-copy>Copy brief text</button>
        <a class="text-button" href={`mailto:${siteMeta.email}`}>Email directly</a>
      </div>
    </form>
  </div>
</section>
