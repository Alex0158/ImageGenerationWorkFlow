---
import { decisionNotes } from '@/data/conversion';
---

<section class="section decision-section" id="decision" aria-labelledby="decision-title">
  <div class="decision-panel" data-reveal>
    <div class="decision-heading">
      <div class="section-kicker">Before You Book</div>
      <h2 class="section-heading" id="decision-title">Clear answers before you send the brief.</h2>
      <p class="section-intro">
        A strong project starts when expectations are clear. These notes remove the common doubts before we talk about style.
      </p>
    </div>
    <ol class="decision-list">
      {decisionNotes.map((item, index) => (
        <li class="decision-item">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
