---
import { proofPoints } from '@/data/site';
---

<section>
  <ul class="proof-strip" aria-label="Project proof points" aria-live="polite">
    {proofPoints.map((point) => (
      <li class="proof-item">
        <div class="proof-value" data-count-target={point.value}>{point.value}</div>
        <div class="proof-label">{point.label}</div>
      </li>
    ))}
  </ul>
</section>
