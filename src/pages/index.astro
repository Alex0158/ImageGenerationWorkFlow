---
import '../styles/global.css';
import BaseHead from '@/components/BaseHead.astro';
import ContactSection from '@/components/ContactSection.astro';
import EngagementSection from '@/components/EngagementSection.astro';
import HeroSection from '@/components/HeroSection.astro';
import OutcomeSection from '@/components/OutcomeSection.astro';
import ProcessSection from '@/components/ProcessSection.astro';
import ProofStrip from '@/components/ProofStrip.astro';
import ShowcaseSection from '@/components/ShowcaseSection.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import WorkGallery from '@/components/WorkGallery.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead />
  </head>
  <body>
    <div class="site-shell">
      <SiteHeader />

      <main id="top">
        <HeroSection />
        <ProofStrip />
        <ShowcaseSection />
        <WorkGallery />
        <OutcomeSection />
        <EngagementSection />
        <ProcessSection />
        <ContactSection />
      </main>

      <SiteFooter />
    </div>

    <script src="../scripts/landing.ts"></script>
  </body>
</html>
